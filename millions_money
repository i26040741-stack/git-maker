choices = ["A", "B", "C", "D"]
prize_box = 0
for position, question in enumerate(questions):
    print(f"Question {position + 1}: {question['question']}")
    for number, choice in enumerate(question['choices']):
        print(f"{choices[number]}. {choice}")
    answer = input("Enter your answer (A, B, C, or D): ").upper()
    while answer not in choices:
        print("Invalid choice. Please select A, B, C, or D.")
        answer = input("Enter your answer (A, B, C, or D): ").upper()
    selected_choice = choices.index(answer)
    selected_answer = question['choices'][selected_choice]
    if selected_answer == question['answer']:
        prize_box += question['prize']
        print(f"Correct! You won ${question['prize']}.")
        print(f"Your total prize is now ${prize_box}.")
    else:
        print(f"Incorrect. The correct answer was {question['answer']}.")
